#
# Makefile for pytest-based E2E test orchestration.
#
# Usage (from tests/ directory):
#   make -f Makefile.pytest setup              # Create venv
#   make -f Makefile.pytest all                # Run all tests
#   make -f Makefile.pytest functional         # Functional only
#   make -f Makefile.pytest unit               # Unit only
#
# Run a single test by name (after setup):
#   cd tests && .venv/bin/pytest -k rest_test -v
#
# Capture a full session log:
#   cd tests && .venv/bin/pytest -k mqtt_roi \
#       --log-file=../test_data/logs/mqtt_roi-$(date +%F-%T).log

SHELL := /bin/bash
PYTEST_VENV := $(CURDIR)/.venv
REPO_ROOT := $(CURDIR)/..
PYTEST := $(PYTEST_VENV)/bin/pytest
LOG_DIR := $(REPO_ROOT)/test_data/logs
TIMESTAMP := $(shell date +%Y-%m-%d-%H:%M:%S)

.PHONY: setup all functional unit clean

setup:
	@if [ ! -d "$(PYTEST_VENV)" ]; then \
		python3 -m venv $(PYTEST_VENV); \
		echo "Installing venv dependencies..."; \
		$(PYTEST_VENV)/bin/pip install --progress-bar on --upgrade pip; \
		$(PYTEST_VENV)/bin/pip install --progress-bar on -r $(CURDIR)/requirements.txt; \
	fi

all: setup
	@mkdir -p $(LOG_DIR)
	$(PYTEST) --log-file=$(LOG_DIR)/all-$(TIMESTAMP).log

functional: setup
	@mkdir -p $(LOG_DIR)
	$(PYTEST) functional/ ../manager/tests/ ../controller/tests/ \
		security/system/ system/stability/ \
		--log-file=$(LOG_DIR)/functional-$(TIMESTAMP).log

unit: setup
	@mkdir -p $(LOG_DIR)
	$(PYTEST) sscape_tests/ \
		--log-file=$(LOG_DIR)/unit-$(TIMESTAMP).log

clean:
	rm -rf $(PYTEST_VENV)
