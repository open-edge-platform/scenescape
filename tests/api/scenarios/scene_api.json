        "request": {
          "UID": "${SCENE_UID}"
        },
        "expected": {
          "status_code": 200
        },
        "validate": {
          "name": "Scene1_Updated_Full",
          "use_tracker": true,
          "output_lla": true,
          "mesh_translation": [
            12.2,
            248,
            12.0
          ],
          "mesh_rotation": [
            12.2,
