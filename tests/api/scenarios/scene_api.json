  {
    "test_name": "Vision_AI/SSCAPE/API/SCENE/08: Update scene with minimal valid payload",
    "test_steps": [
      {
        "step_name": "Update Scene",
        "api": "scene",
        "method": "updateScene",
        "request": {
          "UID": "${SCENE_UID}",
          "body": {
            "name": "Scene1_Updated",
            "use_tracker": false,
            "output_lla": true
          }
        },
        "expected": {
          "status_code": 200
        }
      },
      {
        "step_name": "Verify resource was updated",
        "api": "scene",
        "method": "getScene",
        "request": {
          "UID": "${SCENE_UID}"
        },
        "expected": {
          "status_code": 200
        },
        "validate": {
          "name": "Scene1_Updated",
          "use_tracker": false,
          "output_lla": true
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/SCENE/09: Update scene with full valid payload",
