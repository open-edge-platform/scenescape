[
  {
    "test_name": "Vision_AI/SSCAPE/API/SCENE/01: Create scene with only required properties",
    "test_steps": [
      {
        "step_name": "Create Scene",
        "api": "scene",
        "method": "createScene",
        "request": {
          "body": {
            "name": "Scene1",
            "use_tracker": true,
            "output_lla": false
          }
        },
        "expected": {
          "status_code": 201
        },
        "save": {
          "SCENE_UID": "uid"
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/SCENE/02: Create scene with full valid payload",
    "test_steps": [
      {
        "step_name": "Create Scene",
        "api": "scene",
        "method": "createScene",
        "request": {
          "body": {
            "name": "Scene2",
            "use_tracker": true,
            "output_lla": false,
            "mesh_translation": [
              12.2,
              248,
              12
            ],
            "mesh_rotation": [
              12.2,
              248,
              12
            ],
            "mesh_scale": [
              1,
              1,
              1
            ],
            "tracker_config": [
              1,
              1,
              1
            ]
          }
        },
        "expected": {
          "status_code": 201
        },
        "save": {
          "SCENE_UID_FULL": "uid"
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/SCENE/03: Create scene with missing required name property",
    "test_steps": [
      {
        "step_name": "Create Scene",
        "api": "scene",
        "method": "createScene",
        "request": {
          "body": {
            "use_tracker": true,
            "output_lla": false
          }
        },
        "expected": {
          "status_code": 400
        },
        "save": {
          "SCENE_WITHOUT_NAME": "uid"
        }
      },
      {
        "step_name": "Verify scene was not created",
        "api": "scene",
        "method": "getScene",
        "request": {
          "UID": "${SCENE_WITHOUT_NAME}"
        },
        "expected": {
          "status_code": 404
        }
      }
    ]
  },
