[
  {
    "test_name": "Vision_AI/SSCAPE/API/CALIB/01: Register scene for calibration",
    "test_steps": [
      {
        "step_name": "Start scene registration",
        "api": "calibration",
        "method": "registerScene",
        "request": {
          "sceneId": "302cf49a-97ec-402d-a324-c5077b280b7b",
          "body": {}
        },
        "expected_status": {
          "status_code": 201
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/CALIB/02: Get scene registration status",
    "test_steps": [
      {
        "step_name": "Check the status of scene registration",
        "api": "calibration",
        "method": "getSceneRegistrationStatus",
        "request": {
          "sceneId": "302cf49a-97ec-402d-a324-c5077b280b7b"
        },
        "expected_status": {
          "status_code": 200
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/CALIB/03: Get non existent scene registration status",
    "test_steps": [
      {
        "step_name": "Check the status of registration for non existent scene ",
        "api": "calibration",
        "method": "getSceneRegistrationStatus",
        "request": {
          "sceneId": "123"
        },
        "expected_status": {
          "status_code": 404
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/CALIB/04: Notify of scene updates",
    "test_steps": [
      {
        "step_name": "Notifies the calibration service that a scene has been updated",
        "api": "calibration",
        "method": "updateSceneRegistration",
        "request": {
          "sceneId": "302cf49a-97ec-402d-a324-c5077b280b7b",
          "body": {}
        },
        "expected_status": {
          "status_code": 201
        }
      }
    ]
  },
  {
    "test_name": "Vision_AI/SSCAPE/API/CALIB/05: Notify non existent scene",
    "test_steps": [
      {
        "step_name": "Notify scene updates using PATCH request with invalid scene UID",
        "api": "calibration",
        "method": "updateSceneRegistration",
        "request": {
          "sceneId": "123"
        },
        "expected_status": {
          "status_code": 404
        }
      }
    ]
  },
