        "api": "camera",
        "method": "calibrateCamera",
        "request": {
          "cameraId": "atag-qcam1",
          "body": {
            "name": "Camera_No_Intrinsics",
            "intrinsics": [
              [
                1000,
                0,
                640
              ],
              [
                0,
                1000,
                360
              ],
              [
                0,
                0,
                1
              ]
            ]
          }
        },
        "expected_status": {
          "status_code": 400
        }
      }
    ]
  },
