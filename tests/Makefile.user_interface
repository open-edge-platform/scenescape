# UI / Selenium test targets. Each target invokes pytest with -k <test_id>.
# Test specs are defined in tests/test_ui.py and (for full-stack functional
# tests such as live-view-button) tests/test_functional.py; orchestration is
# managed by conftest.py fixtures.

# Recipes below must be in alphabetical order

