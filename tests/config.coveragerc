# config.coveragerc to control coverage.py
# Paths are relative to the repository root. Each `source` entry gets its own
# threshold check in `make check-unit-coverage`.
[run]
source =
    analytics/src/analytics
    reid_service/src/reid_service
    cluster_analytics/src
omit =
    */.venv/*
    */site-packages/*
    */opt/intel/*
    */tests/*
# below are the units with main functions of services - no point to cover 
    reid_service/src/reid_service/server.py
    cluster_analytics/src/cluster_analytics.py

[report]
ignore_errors = True
show_missing = True

[html]
directory = tests/ui/reports/code_coverage/htmlcov
