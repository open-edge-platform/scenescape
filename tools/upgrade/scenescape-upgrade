"""Command-line entry point for SceneScape upgrade operations."""

import argparse
import json
from pathlib import Path
import sys

from backup import create_backup
from backup import restore_backup
from backup import verify_backup
from migration import apply_migrations
from migration import migration_plan
from migration import read_applied_migrations
from preflight import build_report
from preflight import find_transition
from preflight import load_compatibility
from preflight import resolve_compose
from preflight import STATUS_EXIT_CODES


TOOL_DIR = Path(__file__).resolve().parent
REPOSITORY_ROOT = TOOL_DIR.parents[1]


def create_parser():
  """Create the upgrade command-line parser."""
  parser = argparse.ArgumentParser(description="Plan and execute SceneScape upgrades")
  subparsers = parser.add_subparsers(dest="command", required=True)
  preflight = subparsers.add_parser("preflight", help="run read-only upgrade discovery")
  preflight.add_argument("--source-version", required=True)
  preflight.add_argument("--target-version")
  preflight.add_argument("--deployment-root", type=Path, default=REPOSITORY_ROOT)
  preflight.add_argument("--compose-file", action="append", type=Path, default=[])
  preflight.add_argument("--profile", action="append", default=[])
  preflight.add_argument("--project-name")
  preflight.add_argument("--compatibility", type=Path,
                         default=TOOL_DIR / "compatibility.json")
  preflight.add_argument("--output", type=Path)
  backup = subparsers.add_parser("backup", help="create a verified deployment backup")
  backup.add_argument("--deployment-root", type=Path, default=REPOSITORY_ROOT)
  backup.add_argument("--compose-file", action="append", type=Path, default=[])
  backup.add_argument("--profile", action="append", default=[])
  backup.add_argument("--project-name")
  backup.add_argument("--secrets-dir", type=Path)
  backup.add_argument("--output-dir", type=Path, default=Path.cwd())
  backup.add_argument("--leave-stopped", action="store_true")
  verify = subparsers.add_parser("backup-verify", help="verify backup checksums")
  verify.add_argument("backup_dir", type=Path)
  restore = subparsers.add_parser("restore", help="restore deployment volumes")
  restore.add_argument("backup_dir", type=Path)
  restore.add_argument("--overwrite", action="store_true")
  for name in ("database-check", "database-migrate"):
    database = subparsers.add_parser(name, help=f"{name} authorized database schema")
    database.add_argument("--source-version", required=True)
    database.add_argument("--target-version", required=True)
    database.add_argument("--deployment-root", type=Path, default=REPOSITORY_ROOT)
    database.add_argument("--compose-file", action="append", type=Path, default=[])
    database.add_argument("--profile", action="append", default=[])
    database.add_argument("--project-name")
    database.add_argument("--compatibility", type=Path,
                          default=TOOL_DIR / "compatibility.json")
    database.add_argument("--operation-dir", type=Path, default=Path("upgrade-state"))
  return parser


def current_version(deployment_root):
  """Read the target checkout version."""
  return (deployment_root / "version.txt").read_text(encoding="utf-8").strip()


def run_preflight(args):
  """Execute preflight and return its stable status exit code."""
  target_version = args.target_version or current_version(args.deployment_root)
  compose_files = args.compose_file or [args.deployment_root / "docker-compose.yml"]
  manifest = load_compatibility(args.compatibility)
  transition = find_transition(manifest, args.source_version, target_version)
  compose_config = resolve_compose(compose_files, args.profile, args.project_name)
  report = build_report(
    args.source_version, target_version, transition, compose_config,
    args.deployment_root, compose_files, args.profile, args.project_name)
  output = json.dumps(report, indent=2, sort_keys=True) + "\n"
  if args.output:
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(output, encoding="utf-8")
  else:
    sys.stdout.write(output)
  return STATUS_EXIT_CODES[report["status"]]


def compose_inputs(args):
  """Resolve common Compose command inputs."""
  compose_files = args.compose_file or [args.deployment_root / "docker-compose.yml"]
  compose_config = resolve_compose(compose_files, args.profile, args.project_name)
  return compose_files, compose_config


def run_backup(args):
  """Create and verify a complete deployment backup."""
  compose_files, compose_config = compose_inputs(args)
  secrets_dir = args.secrets_dir or args.deployment_root / "manager" / "secrets"
  backup_dir, _manifest = create_backup(
    compose_config, args.deployment_root, compose_files, args.profile,
    secrets_dir, args.output_dir, leave_stopped=args.leave_stopped)
  verify_backup(backup_dir)
  sys.stdout.write(json.dumps({
    "schema_version": 1, "operation": "backup", "status": "ready",
    "backup_dir": str(backup_dir),
  }, indent=2, sort_keys=True) + "\n")
  return STATUS_EXIT_CODES["ready"]


def run_backup_verify(args):
  """Verify a backup bundle."""
  manifest = verify_backup(args.backup_dir)
  sys.stdout.write(json.dumps({
    "schema_version": 1, "operation": "backup_verify", "status": "ready",
    "operation_id": manifest["operation_id"],
  }, indent=2, sort_keys=True) + "\n")
  return STATUS_EXIT_CODES["ready"]


def run_restore(args):
  """Restore all volume artifacts from a verified backup."""
  restored = restore_backup(args.backup_dir, overwrite=args.overwrite)
  sys.stdout.write(json.dumps({
    "schema_version": 1, "operation": "restore", "status": "ready",
    "restored_volumes": restored,
  }, indent=2, sort_keys=True) + "\n")
  return STATUS_EXIT_CODES["ready"]


def run_database(args, apply=False):
  """Check or apply an explicitly authorized database schema transition."""
  manifest = load_compatibility(args.compatibility)
  transition = find_transition(manifest, args.source_version, args.target_version)
  if transition is None:
    sys.stdout.write(json.dumps({
      "schema_version": 1,
      "operation": "database_migrate" if apply else "database_check",
      "status": "unsupported",
      "blockers": [{
        "code": "unsupported_transition",
        "message": "No authorized database transition",
      }],
    }, indent=2, sort_keys=True) + "\n")
    return STATUS_EXIT_CODES["unsupported"]
  compose_files, compose_config = compose_inputs(args)
  project_name = args.project_name or compose_config.get("name")
  if apply:
    state = apply_migrations(compose_files, args.profile, project_name, transition,
                             args.operation_dir)
    plan = state["migration_plan"]
  else:
    applied = read_applied_migrations(compose_files, args.profile, project_name)
    plan = migration_plan(transition, applied)
  status = "action_required" if plan["pending"] else "ready"
  sys.stdout.write(json.dumps({
    "schema_version": 1, "operation": "database_migrate" if apply else "database_check",
    "status": status, "migration_plan": plan,
  }, indent=2, sort_keys=True) + "\n")
  return STATUS_EXIT_CODES[status]


def main():
  """Run the selected upgrade operation."""
  args = create_parser().parse_args()
  try:
    if args.command == "preflight":
      return run_preflight(args)
    if args.command == "backup":
      return run_backup(args)
    if args.command == "backup-verify":
      return run_backup_verify(args)
    if args.command == "restore":
      return run_restore(args)
    if args.command == "database-check":
      return run_database(args)
    if args.command == "database-migrate":
      return run_database(args, apply=True)
  except (OSError, ValueError, json.JSONDecodeError) as error:
    report = {
      "schema_version": 1,
      "operation": f"upgrade_{args.command}",
      "status": "failed",
      "error": {"code": "preflight_failed", "message": str(error)},
    }
    sys.stdout.write(json.dumps(report, indent=2, sort_keys=True) + "\n")
    return STATUS_EXIT_CODES["failed"]
  return STATUS_EXIT_CODES["failed"]


if __name__ == "__main__":
  sys.exit(main())