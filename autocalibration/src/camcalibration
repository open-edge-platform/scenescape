import argparse
import logging
from pathlib import Path

from auto_camera_calibration_context import CameraCalibrationContext
from auto_camera_calibration_api import CameraCalibrationApi

# Configure logging
logging.basicConfig(level=logging.DEBUG)
log = logging.getLogger("camcalibration-fastapi")

def build_argparser():
  parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)
  parser.add_argument("--broker", default="broker.scenescape.intel.com",
                      help="hostname or IP of MQTT broker")
  parser.add_argument("--brokerauth", default="/run/secrets/calibration.auth",
                      help="user:password or JSON file for MQTT authentication")
  parser.add_argument("--resturl", default="https://web.scenescape.intel.com/api/v1",
                      help="URL of REST API")
  parser.add_argument("--restauth", required=True,
                      help="user:password or JSON file for REST authentication")
  parser.add_argument("--rootcert", default="/run/secrets/certs/scenescape-ca.pem",
                      help="path to ca certificate")
  parser.add_argument("--cert",
                      help="path to client certificate")
  parser.add_argument('--restport', type=int, default=8000, help='Exposed REST API server port')
  parser.add_argument('--tls', action='store_true',
                      help='Enable HTTPS/TLS for the REST API server')
  parser.add_argument('--ssl-certfile',
                      help='Path to SSL certificate file (required if --tls is enabled)')
  parser.add_argument('--ssl-keyfile',
                      help='Path to SSL private key file (required if --tls is enabled)')
  parser.add_argument('--ssl-ca-certs',
                      help='Path to CA certificate file')

  return parser

def validate_tls_config(args):
    """Validate TLS configuration arguments."""
    if args.tls:
        if not args.ssl_certfile or not args.ssl_keyfile:
            raise ValueError("--ssl-certfile and --ssl-keyfile are required when --tls is enabled")

        cert_path = Path(args.ssl_certfile)
        key_path = Path(args.ssl_keyfile)

        if not cert_path.exists():
            raise FileNotFoundError(f"SSL certificate file not found: {args.ssl_certfile}")
        if not key_path.exists():
            raise FileNotFoundError(f"SSL private key file not found: {args.ssl_keyfile}")

        if args.ssl_ca_certs:
            ca_path = Path(args.ssl_ca_certs)
            if not ca_path.exists():
                raise FileNotFoundError(f"SSL CA certificate file not found: {args.ssl_ca_certs}")

    return True

def main():
  args = build_argparser().parse_args()

  try:
      validate_tls_config(args)
  except (ValueError, FileNotFoundError) as e:
      log.error(f"TLS configuration error: {e}")
      return 1

  print("Auto Camera Calibration Container (FastAPI) started")

  camera_calibration_controller = CameraCalibrationContext(
      args.broker,
      args.brokerauth,
      args.cert,
      args.rootcert,
      args.resturl,
      args.restauth,
  )

  camera_calibration_controller.preprocessScenes()

  api = CameraCalibrationApi(camera_calibration_controller)

  if args.tls:
      log.info(f"Starting FastAPI server with TLS on port {args.restport}")
      log.info(f"Certificate: {args.ssl_certfile}")
      log.info(f"Private Key: {args.ssl_keyfile}")
      if args.ssl_ca_certs:
          log.info(f"CA Certificate: {args.ssl_ca_certs}")

      api.start_with_tls(
          port=args.restport,
          certfile=args.ssl_certfile,
          keyfile=args.ssl_keyfile,
          ca_certs=args.ssl_ca_certs
      )
  else:
      log.info(f"Starting FastAPI server without TLS on port {args.restport}")
      api.start(args.restport)

  return

if __name__ == '__main__':
  exit(main() or 0)
