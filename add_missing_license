import json
import subprocess
import pprint
import fileinput
import re
from pathlib import Path
from time import sleep

def add_license_to_file(file_path):
    if Path(file_path).suffix == '':
        print(f"File without extension: {file_path}")
        with open(file_path, 'r') as f:
            first_line = f.readline().strip()
            if first_line == "#!/usr/bin/env python3":
                print(f"File {file_path} recognized as Python script.")
                subprocess.run(["make", "add-licensing", "FILE=" + item, "ADDITIONAL_LICENSING_ARGS=", "--style=\"python\""])
            elif first_line == "#!/bin/bash":
                print(f"File {file_path} recognized as Bash script.")
                subprocess.run(["make", "add-licensing", "FILE=" + item, "ADDITIONAL_LICENSING_ARGS=", "--style=\"bash\""])
            else:
                print(f"File {file_path} unrecognized, using default style.")
                subprocess.run(["make", "add-licensing", "FILE=" + item, "ADDITIONAL_LICENSING_ARGS="])
    else:
        subprocess.run(["make", "add-licensing", "FILE=" + item])

json_file = 'reuse_lint.json'  # Change this to your JSON file path

with open(json_file, 'r') as f:
    data = json.load(f)

pprint.pp(data)

for item in data.get("non_compliant").get("missing_licensing_info", []):
    sleep(2)
    if item in data.get("non_compliant").get("missing_copyright_info", []):
        print(f"Adding license to {item}")
        add_license_to_file(item)
    else:
        for line in fileinput.input(item, inplace=True):
            if re.match(r'.*Copyright \(C\).*',line):
                print('{}'.format(line.replace("Copyright (C)","SPDX-FileCopyrightText: (C)")),end='') # for Python 3
            else:
                print('{}'.format(line),end='')
        add_license_to_file(item)
