    {
        "id": "2dc2a19801a6130c",
        "type": "function",
        "z": "333da36bb73fce05",
        "name": "Save ROI to Context",
        "func": "const data = msg.payload;\nlet scenes = flow.get('scenes') || {};\n\nconst scene = scenes[data.scene_id] ?? {};\n\nscene.name = data.scene_name;\nscene.id = data.scene_id;\n\nconst region_id = data.region_id;\nconst regions = scene['regions'] ?? {};\nconst region = regions[region_id] ?? {};\nregion.name = data.region_name;\nregion.occupancy = data.occupancy;\nregions[region_id] = region;\nscene['regions'] = regions;\n\nscenes[data.scene_id] = scene;\nflow.set('scenes', scenes);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
