    {
        "id": "0feee542068ece27",
        "type": "ui-template",
        "z": "333da36bb73fce05",
        "group": "3450403b3bce9759",
        "page": "",
        "ui": "",
        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 16px; padding: 16px;\">\n\n    <!-- One card per scene -->\n    <div v-for=\"scene in msg.payload\" :key=\"scene.id\" style=\"\n        flex: 1 1 440px;\n        min-width: min(100%, 400px);\n        max-width: 100%;\n        box-sizing: border-box;\n        background: #1e1e2e;\n        border-radius: 12px;\n        padding: 16px;\n        color: white;\n        box-shadow: 0 4px 8px rgba(0,0,0,0.3);\n      \">\n\n      <!-- Scene Header -->\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;\">\n        <h3 style=\"margin: 0; color: #89b4fa;\">{{ scene.name }}</h3>\n      </div>\n\n      <hr style=\"border-color: #313244; margin-bottom: 12px;\" />\n\n      <div style=\"margin-bottom: 12px;\">\n        <p style=\"color: #a6adc8; margin: 0 0 6px 0; font-size: 0.85em;\">\n          In Scene\n        </p>\n        <div style=\"display: flex; flex-wrap: wrap; gap: 6px;\">\n          <span v-for=\"(count, category) in scene.objectPerCategory\" :key=\"category\" style=\"\n            background: #313244;\n            padding: 4px 10px;\n            border-radius: 20px;\n            font-size: 0.85em;\n            overflow-wrap: anywhere;\n          \">\n            {{ category }}: {{ count }}\n          </span>\n          <span v-if=\"!Object.keys(scene.objectPerCategory || {}).length\" style=\"\n            background: #313244;\n            border-radius: 6px;\n            padding: 6px 10px;\n            color: #a6adc8;\n            font-size: 0.85em;\n          \">\n            No detections\n          </span>\n        </div>\n      </div>\n\n      <!-- Regions -->\n      <div style=\"margin-bottom: 12px;\">\n        <p style=\"color: #a6adc8; margin: 0 0 6px 0; font-size: 0.85em;\">\n          📍 REGIONS\n        </p>\n        <div v-for=\"region in scene.regions\" :key=\"region.name\" style=\"\n            display: flex;\n            justify-content: space-between;\n            background: #313244;\n            border-radius: 6px;\n            padding: 6px 10px;\n            margin-bottom: 4px;\n          \">\n          <span>{{ region.name }}</span>\n          <span :style=\"{ color: region.occupancy <= 1 ? '#a6e3a1' : region.occupancy < 3 ? '#f9e2af' : '#f38ba8' }\">\n            {{ region.occupancy }} 👤\n          </span>\n        </div>\n        <p v-if=\"scene.regions.length === 0\" style=\"color: #6c7086; font-size: 0.85em;\">\n          No regions\n        </p>\n      </div>\n\n      <!-- Tripwires -->\n      <div>\n        <p style=\"color: #a6adc8; margin: 0 0 6px 0; font-size: 0.85em;\">\n          🚧 TRIPWIRES\n        </p>\n        <div v-for=\"tripwire in scene.tripwires\" :key=\"tripwire.name\" style=\"\n            background: #313244;\n            border-radius: 6px;\n            padding: 6px 10px;\n            margin-bottom: 4px;\n          \">\n          <span>{{ tripwire.name }}</span>\n          <ul v-if=\"tripwire.events && tripwire.events.length\"\n            style=\"margin: 6px 0 0; padding-left: 20px; overflow-wrap: anywhere;\">\n            <li v-for=\"(event, index) in tripwire.events\" :key=\"event.date + ':' + index\">\n              {{ new Date(event.date).toLocaleTimeString() }}\n              {{ event.category }} {{ event.direction === 'in' ? '⬆️' : '⬇️' }}\n            </li>\n          </ul>\n          <p v-else style=\"color: #a6adc8; margin: 6px 0 0; font-size: 0.85em;\">\n            No recent events\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>",
