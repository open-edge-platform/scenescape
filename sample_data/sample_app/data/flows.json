    {
        "id": "5146281553e5169b",
        "type": "function",
        "z": "333da36bb73fce05",
        "name": "Tripwire Events",
        "func": "const newPayload = {}\n\nconst data = msg.payload;\n\nconst objects = data.objects;\n\nconst filteredObjects = [];\n\nobjects.forEach(function(object) {\n    const newObject = {};\n    newObject.category = object.category;\n    newObject.direction = (object.direction == 1) ? \"in\" : \"out\";\n    filteredObjects.push(newObject);\n});\n\nnewPayload.scene_name = data.scene_name;\nnewPayload.scene_id = data.scene_id;\nnewPayload.tripwire_name = data.tripwire_name;\nnewPayload.tripwire_id = data.tripwire_id;\nnewPayload.timestamp = data.timestamp;\nnewPayload.objects = filteredObjects;\n\nmsg.payload = newPayload;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
