    {
        "id": "ae7b6326e9f288c6",
        "type": "function",
        "z": "333da36bb73fce05",
        "name": "Count Objects",
        "func": "const newPayload = {};\n\nconst data = msg.payload;\n\nconst objects = data.objects;\n\nconst uniqueCategories = new Set(Array.from((function* () { for (const key in objects) yield objects[key].category; })()));\n\nconst objectPerCategory = {};\n\nfor (const category of uniqueCategories) {\n  objectPerCategory[category] = 0;\n  for (const key in objects) {\n    const object = objects[key];\n    if (object.category !== category) continue;\n    objectPerCategory[category] += 1;\n  }\n}\n\n\nnewPayload.scene_name = data.name;\nnewPayload.scene_id = data.id;\nnewPayload.timestamp = data.timestamp;\nnewPayload.objectPerCategory = objectPerCategory;\n\nmsg.payload = newPayload;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 260,
        "wires": [
