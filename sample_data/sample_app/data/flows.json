                "5d70c03bd1a2299f"
            ]
        ]
    },
    {
        "id": "4e3f2d14b0440e33",
        "type": "function",
        "z": "333da36bb73fce05",
        "name": "ROI Occupancy",
        "func": "const newPayload = {}\n\nconst data = msg.payload;\n\nnewPayload.scene_name = data.scene_name;\nnewPayload.scene_id = data.scene_id;\nnewPayload.region_name = data.region_name;\nnewPayload.region_id = data.region_id;\nnewPayload.timestamp = data.timestamp;\n\nconst countObjects = Object.values(data.counts)\nconst occupancy = countObjects.reduce((accumulator, value) => {\n  return accumulator + value;\n}, 0)\nnewPayload.occupancy = occupancy;\n\nmsg.payload = newPayload;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
