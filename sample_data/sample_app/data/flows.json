    {
        "id": "5cabbd09eb7ef27e",
        "type": "function",
        "z": "333da36bb73fce05",
        "name": "Save Tripwire to Context",
        "func": "const data = msg.payload;\nlet scenes = flow.get('scenes') || {};\nconst now = Date.now();\nconst cutoff = now - 30_000;\n\nObject.values(scenes).forEach(function (existingScene) {\n\tObject.values(existingScene.tripwires ?? {}).forEach(function (existingTripwire) {\n\t\texistingTripwire.events = (existingTripwire.events ?? []).filter(function (event) {\n\t\t\treturn event.date >= cutoff;\n\t\t});\n\t});\n});\n\nconst scene = scenes[data.scene_id] ?? {};\n\nscene.name = data.scene_name;\nscene.id = data.scene_id;\n\nconst tripwires = scene['tripwires'] ?? {};\nconst tripwire = tripwires[data.tripwire_id] ?? {};\n\ntripwire.name = data.tripwire_name;\ntripwire.objects = data.objects;\ntripwire.events = tripwire.events ?? [];\n(data.objects ?? []).forEach(function (object) {\n\ttripwire.events.push({\n\t\tdate: now,\n\t\tcategory: object.category,\n\t\tdirection: object.direction,\n\t});\n});\n\ntripwires[data.tripwire_id] = tripwire;\n\nscene['tripwires'] = tripwires;\nscenes[data.scene_id] = scene;\nflow.set('scenes', scenes);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
