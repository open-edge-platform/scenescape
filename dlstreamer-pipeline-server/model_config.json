{
  "retail": {
    "type": "detect",
    "params": {
      "model": "intel/person-detection-retail-0013/FP32/person-detection-retail-0013.xml",
      "model_proc": "object_detection/person/person-detection-retail-0013.json"
    },
    "adapter-params": {
      "metadatagenpolicy": "detectionPolicy"
    }
  },
  "reid": {
    "type": "inference",
    "params": {
      "model": "intel/person-reidentification-retail-0277/FP32/person-reidentification-retail-0277.xml"
    },
    "adapter-params": {
      "metadatagenpolicy": "reidPolicy"
    }
  },
  "yolox_s_fp16": {
    "type": "triton",
    "params": {
      "model": "yolox_s_fp16",
      "model-type": "yolo",
      "inference-script": "yolox_triton_inference",
      "triton-url": "tritonserver:8001",
      "input-name": "images",
      "output-names": "num_dets,det_boxes,det_scores,det_classes",
      "input-width": "640",
      "input-height": "640",
      "confidence-threshold": "0.45",
      "nms-threshold": "0.35",
      "num-classes": "80",
      "labels": ["person"],
      "use-ensemble": true,
      "ensemble-model-name": "yolox_s_ensemble"
    },
    "adapter-params": {
      "metadatagenpolicy": "detectionPolicy"
    }
  },
  "yolov7_tiny_e2e": {
    "type": "triton",
    "params": {
      "model": "yolov7_tiny_e2e_v1",
      "model-type": "yolo",
      "inference-script": "yolov7_triton_inference",
      "triton-url": "tritonserver:8001",
      "input-name": "images",
      "output-names": "num_dets,det_boxes,det_scores,det_classes",
      "input-width": "640",
      "input-height": "640",
      "confidence-threshold": "0.45",
      "nms-threshold": "0.35",
      "num-classes": "80",
      "labels": ["person"],
      "use-ensemble": true,
      "ensemble-model-name": "yolov7_ensemble"
    },
    "adapter-params": {
      "metadatagenpolicy": "detectionPolicy"
    }
  }
}
