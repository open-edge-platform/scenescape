#!/usr/bin/env python3
import argparse
import json
import re
import time
from datetime import datetime
from scene_common.json_track_data import CamManager
from scene_common.timestamp import get_iso_time, get_epoch_time
from scene_common.mqtt import PubSub


print(f"before duration")

def parse_duration(duration_str):
    match = re.match(r'^(\d+)([smh]?)$', duration_str.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError("Duration must be like 60s, 5m, 2h")
    value, unit = match.groups()
    value = int(value)
    return value * {'s': 1, 'm': 60, 'h': 3600}.get(unit or 's', 1)

def parse_args():
    parser = argparse.ArgumentParser(description="Monitor FPS and fell-behind frames from MQTT")
    parser.add_argument("--broker", default="broker.scenescape.intel.com", help="MQTT broker address")
    parser.add_argument("--port", default=1883, help="MQTT broker port")
    parser.add_argument("--auth", default="/run/secrets/browser.auth", help="Path to MQTT auth file (.json)")
    parser.add_argument("--cert", help="Path to client cert (optional)")
    parser.add_argument("--rootcert", default="/run/secrets/certs/scenescape-ca.pem", help="Path to root CA cert (optional)")
    parser.add_argument("--duration", type=parse_duration, default="60s", help="Duration to run (e.g., 60s, 5m, 2h)")
    parser.add_argument("--threshold", type=float, default=10.0, help="FPS threshold for FELL BEHIND")
    return parser.parse_args()

def on_connect(client, userdata, flags, rc):
    if rc == 0:
        print("Connected to broker.")
        topic = PubSub.formatTopic(PubSub.DATA_CAMERA, camera_id="+")
        client.subscribe(topic)
        print(f"Subscribed to topic: {topic}")
    else:
        print(f"Failed to connect, return code {rc}")

def main():
    args = parse_args()
    client = PubSub(args.auth, None, args.rootcert, args.broker, args.port)

    #start_time = time.time()
    fell_behind = 0
    msg_count = 0
    times = []
    processing_times = []

    def on_message(topic, payload):
        nonlocal msg_count, fell_behind, times, processing_times
        try:
            data = json.loads(payload)
            fps = float(data.get("fps", 0))
            debug_time = float(data.get("debug_processing_time", 0))
            ts = data.get("postdecode_timestamp")

            if fps < args.threshold:
                fell_behind += 1

            if ts:
                try:
                    dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
                    times.append(dt)
                except Exception:
                    pass

            processing_times.append(debug_time)
            msg_count += 1
        except Exception as e:
            print(f"[Error] Topic: {topic} — Failed to parse message: {e}")
    print(f"Perf tests hitted from perf directory")

    client.client.on_connect = on_connect
    client.client.on_message = on_message

    print(f"Connecting to broker {args.broker}...")
    client.connect()
    client.client.loop_start()

    start_time = time.time()
    print(f"Monitoring for {args.duration} seconds...")

    try:
        while time.time() - start_time < args.duration:
            time.sleep(0.1)
    except KeyboardInterrupt:
        print("Interrupted.")
    finally:
        client.disconnect()
        client.client.loop_stop()

    # Final results
    print(f"\n--- Results after {args.duration} seconds ---")
    if len(times) > 1:
        times.sort()
        total_time = (times[-1] - times[0]).total_seconds()
        rate = msg_count / total_time if total_time > 0 else 0
        avg_processing_time = sum(processing_times) / len(processing_times) if processing_times else 0

        print(f"Total messages: {msg_count}")
        print(f"Avg rate: {rate:.2f} messages/sec")
        print(f"Avg processing time: {avg_processing_time * 1000:.2f} ms")
        print(f"FELL BEHIND frames (fps < {args.threshold}): {fell_behind}")
    else:
        print("Not enough data collected to compute stats.")

if __name__ == "__main__":
    main()
