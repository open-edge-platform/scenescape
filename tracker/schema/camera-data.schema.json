{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenescape.intel.com/tracker/schema/camera-data.schema.json",
  "title": "Camera Data Message",
  "description": "Camera detection payload for MQTT topic scenescape/data/camera/{camera_id}",
  "type": "object",
  "required": ["id", "timestamp", "objects"],
  "examples": [
    {
      "id": "atag-qcam1",
      "timestamp": "2025-10-08T13:21:40.482Z",
      "objects": {
        "person": [
          {
            "id": 1,
            "bounding_box_px": { "x": 4, "y": 0, "width": 127, "height": 309 }
          }
        ]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Camera/sensor identifier (matches {camera_id} in MQTT topic)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of frame acquisition"
    },
    "objects": {
      "type": "object",
      "description": "Detections grouped by category (e.g., person, vehicle)",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/detection"
        }
      }
    }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "oneOf": [
        { "required": ["bounding_box_px"] },
        { "required": ["translation", "size"] }
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Frame-local detection ID (not persistent across frames)",
          "minimum": 0
        },
        "bounding_box_px": {
          "$ref": "#/$defs/bounding_box",
          "description": "Bounding box in pixel coordinates"
        },
        "translation": {
          "type": "array",
          "description": "Sensor-local 3-D position [x, y, z] meters (e.g. LiDAR), alternative to bounding_box_px. Transformed to world space via the sensor's extrinsics only (no ground-plane ray casting).",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "size": {
          "type": "array",
          "description": "Object size [length, width, height] meters, required alongside translation",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "description": "Sensor-local orientation quaternion [x, y, z, w], optional alongside translation",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "metadata": {
          "type": "object",
          "description": "Optional per-detection metadata (e.g., reid, gender, age). Keys and values are detector-defined.",
          "additionalProperties": true
        },
        "confidence": {
          "type": "number",
          "description": "Optional detection confidence score in [0, 1]",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "description": "Debug aid: which sensor produced this detection (e.g. \"lidar\"/\"camera\"), passed through to the track output"
        }
      },
      "additionalProperties": true
    },
    "bounding_box": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number",
          "description": "X coordinate of top-left corner"
        },
        "y": {
          "type": "number",
          "description": "Y coordinate of top-left corner"
        },
        "width": {
          "type": "number",
          "description": "Width in pixels",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "description": "Height in pixels",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
