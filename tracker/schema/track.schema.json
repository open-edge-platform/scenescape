{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenescape.intel.com/tracker/schema/track.schema.json",
  "title": "Track Message",
  "description": "Track output message published by Tracker Service via MQTT topic scenescape/data/scene/{scene_id}/{thing_type}",
  "type": "object",
  "required": ["id", "timestamp", "objects"],
  "examples": [
    {
      "id": "scene-001",
      "name": "Main Hall",
      "timestamp": "2025-12-30T10:15:30.145Z",
      "objects": [
        {
          "id": 67890,
          "category": "person",
          "translation": [2.5, 3.1, 0.0],
          "velocity": [0.3, -0.1, 0.0],
          "size": [0.5, 0.5, 1.7],
          "rotation": [0, 0, 0, 1]
        },
        {
          "id": 67891,
          "category": "person",
          "translation": [5.2, 1.8, 0.0],
          "velocity": [-0.2, 0.4, 0.0],
          "size": [0.5, 0.5, 1.6],
          "rotation": [0, 0, 0, 1]
        }
      ]
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Scene identifier",
      "examples": ["scene-001", "lobby", "warehouse-a"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable scene name",
      "examples": ["Main Hall", "Lobby", "Warehouse A"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of track computation",
      "examples": ["2025-12-30T10:15:30.145Z"]
    },
    "objects": {
      "type": "array",
      "description": "Tracked objects in world coordinates",
      "items": {
        "$ref": "#/$defs/tracked_object"
      }
    }
  },
  "$defs": {
    "tracked_object": {
      "type": "object",
      "required": ["id", "category", "translation"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Persistent track ID (stable across frames while tracked)",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "description": "Object category (e.g., person, vehicle)"
        },
        "translation": {
          "type": "array",
          "description": "World position [x, y, z] in meters",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "velocity": {
          "type": "array",
          "description": "Velocity [vx, vy, vz] in meters/second",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "size": {
          "type": "array",
          "description": "Object size [length, width, height] in meters",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "description": "Orientation quaternion [x, y, z, w]",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
