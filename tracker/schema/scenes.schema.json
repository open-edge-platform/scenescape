{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenescape.intel.com/tracker/schema/scenes.schema.json",
  "title": "Scenes Configuration",
  "description": "Scene topology and camera configuration for Tracker Service",
  "type": "object",
  "required": ["cameras", "scenes"],
  "examples": [
    {
      "cameras": [
        {
          "id": "camera-01",
          "name": "Entrance Camera",
          "intrinsics": { "fx": 1000, "fy": 1000, "cx": 640, "cy": 360 },
          "distortion": { "k1": 0.0, "k2": 0.0, "p1": 0.0, "p2": 0.0 }
        },
        {
          "id": "camera-02",
          "name": "Exit Camera",
          "intrinsics": { "fx": 1000, "fy": 1000, "cx": 640, "cy": 360 },
          "distortion": { "k1": 0.0, "k2": 0.0, "p1": 0.0, "p2": 0.0 }
        }
      ],
      "scenes": [
        {
          "id": "scene-001",
          "name": "Main Hall",
          "cameras": ["camera-01", "camera-02"]
        }
      ]
    }
  ],
  "properties": {
    "cameras": {
      "type": "array",
      "description": "Camera definitions with calibration data",
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "scenes": {
      "type": "array",
      "description": "Scene definitions with camera assignments",
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "camera": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Camera identifier (matches MQTT topic camera_id)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable camera name"
        },
        "intrinsics": {
          "type": "object",
          "description": "Camera intrinsic parameters",
          "properties": {
            "fx": {
              "type": "number",
              "description": "Focal length X (pixels)"
            },
            "fy": {
              "type": "number",
              "description": "Focal length Y (pixels)"
            },
            "cx": {
              "type": "number",
              "description": "Principal point X (pixels)"
            },
            "cy": {
              "type": "number",
              "description": "Principal point Y (pixels)"
            }
          },
          "additionalProperties": true
        },
        "distortion": {
          "type": "object",
          "description": "Lens distortion coefficients",
          "properties": {
            "k1": { "type": "number" },
            "k2": { "type": "number" },
            "p1": { "type": "number" },
            "p2": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": ["id", "name", "cameras"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Scene identifier (used in MQTT topic)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable scene name"
        },
        "cameras": {
          "type": "array",
          "description": "List of camera IDs assigned to this scene",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
