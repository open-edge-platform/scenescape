{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenescape.intel.com/tracker/schema/config.schema.json",
  "title": "Tracker Service Configuration",
  "description": "Main configuration file for Tracker Service",
  "type": "object",
  "required": ["mqtt", "scenes"],
  "examples": [
    {
      "mqtt": {
        "host": "broker.scenescape.intel.com",
        "port": "8883",
        "client_id": "tracker-service",
        "qos": 1,
        "ssl": {
          "enabled": true,
          "ca_cert_path": "/certs/ca.crt",
          "client_cert_path": "/certs/client.crt",
          "client_key_path": "/certs/client.key",
          "verify_server": true
        }
      },
      "metrics": {
        "enabled": true,
        "otlp_endpoint": "http://otel-collector:4318",
        "export_interval_seconds": 10
      },
      "tracing": {
        "enabled": false
      },
      "logging": {
        "level": "info"
      },
      "scenes": {
        "source": "file",
        "file_path": "config/scenes.json"
      },
      "time_chunking_fps": 15,
      "max_lag_seconds": 1.0
    },
    {
      "mqtt": {
        "host": "manager",
        "port": "8883",
        "client_id": "tracker-service",
        "qos": 1,
        "ssl": {
          "enabled": true,
          "ca_cert_path": "/run/secrets/ca-cert",
          "client_cert_path": "/run/secrets/client-cert",
          "client_key_path": "/run/secrets/client-key"
        }
      },
      "scenes": {
        "source": "api",
        "api_endpoint": {
          "url": "https://manager:443",
          "username": "tracker",
          "password": "secret"
        }
      },
      "time_chunking_fps": 15
    }
  ],
  "properties": {
    "mqtt": {
      "type": "object",
      "description": "MQTT broker connection settings",
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "description": "Broker hostname or IP address",
          "examples": [
            "broker.scenescape.intel.com",
            "localhost",
            "192.168.1.100"
          ]
        },
        "port": {
          "type": ["string", "integer"],
          "description": "Broker port (typically 1883 for TCP, 8883 for TLS)",
          "examples": ["8883", 1883, 8883]
        },
        "client_id": {
          "type": "string",
          "description": "MQTT client identifier",
          "examples": ["tracker-service", "tracker-0", "tracker-prod-01"]
        },
        "qos": {
          "type": "integer",
          "description": "Quality of Service level",
          "enum": [0, 1, 2],
          "default": 1
        },
        "ssl": {
          "type": "object",
          "description": "TLS/SSL settings for secure connections",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "ca_cert_path": {
              "type": "string",
              "description": "Path to CA certificate file",
              "examples": ["/certs/ca.crt", "/run/secrets/ca-cert"]
            },
            "client_cert_path": {
              "type": "string",
              "description": "Path to client certificate file",
              "examples": ["/certs/client.crt", "/run/secrets/client-cert"]
            },
            "client_key_path": {
              "type": "string",
              "description": "Path to client private key file",
              "examples": ["/certs/client.key", "/run/secrets/client-key"]
            },
            "verify_server": {
              "type": "boolean",
              "description": "Verify server certificate",
              "default": true
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "OpenTelemetry metrics export settings",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "otlp_endpoint": {
          "type": "string",
          "description": "OTLP HTTP endpoint (e.g., http://otel-collector:4318)",
          "examples": ["http://otel-collector:4318", "http://localhost:4318"]
        },
        "export_interval_seconds": {
          "type": "integer",
          "description": "Metrics export interval",
          "default": 10,
          "examples": [10, 30, 60]
        },
        "service_name": {
          "type": "string",
          "description": "Service name for telemetry",
          "default": "tracker-service"
        }
      }
    },
    "tracing": {
      "type": "object",
      "description": "OpenTelemetry distributed tracing settings",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "otlp_endpoint": {
          "type": "string",
          "description": "OTLP HTTP endpoint for traces",
          "examples": ["http://otel-collector:4318", "http://jaeger:4318"]
        },
        "service_name": {
          "type": "string",
          "default": "tracker-service"
        }
      }
    },
    "logging": {
      "type": "object",
      "description": "Logging configuration",
      "properties": {
        "level": {
          "type": "string",
          "description": "Log level",
          "enum": ["trace", "debug", "info", "warning", "error"],
          "default": "info"
        }
      }
    },
    "scenes": {
      "type": "object",
      "description": "Scene configuration source",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Configuration source: file or api",
          "enum": ["file", "api"]
        },
        "file_path": {
          "type": "string",
          "description": "Path to scenes.json (required if source=file)",
          "examples": ["config/scenes.json", "/etc/tracker/scenes.json"]
        },
        "api_endpoint": {
          "type": "object",
          "description": "Manager API settings (required if source=api)",
          "properties": {
            "url": {
              "type": "string",
              "description": "Manager API base URL (e.g., https://manager:443)",
              "examples": ["https://manager:443", "https://localhost:443"]
            },
            "username": {
              "type": "string",
              "description": "API authentication username",
              "examples": ["tracker", "admin"]
            },
            "password": {
              "type": "string",
              "description": "API authentication password"
            },
            "skip_ssl_verification": {
              "type": "boolean",
              "description": "Skip SSL certificate verification (development only)",
              "default": false
            }
          },
          "required": ["url", "username", "password"]
        }
      }
    },
    "time_chunking_fps": {
      "type": "integer",
      "description": "Batch processing rate in frames per second",
      "default": 15,
      "minimum": 1,
      "maximum": 60,
      "examples": [15, 30]
    },
    "max_lag_seconds": {
      "type": "number",
      "description": "Maximum acceptable detection lag before dropping",
      "default": 1.0,
      "minimum": 0.1,
      "examples": [0.5, 1.0, 2.0]
    }
  },
  "additionalProperties": true
}
