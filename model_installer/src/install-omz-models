#!/bin/bash
# install-omz-models: Script to download Open Model Zoo models

set -e

MODEL_DIR="${MODEL_DIR:-./models}"
PRECISIONS="${PRECISIONS:-FP32}"

_DEFAULT_MODELS = [
  'person-detection-retail-0013',
  'person-reidentification-retail-0277',
  'human-pose-estimation-0001',
]

_OCR_MODELS = [
  'horizontal-text-detection-0001',
  'text-recognition-resnet-fc',
]

_ALL_MODELS = _DEFAULT_MODELS + _OCR_MODELS + [
  'pedestrian-and-vehicle-detector-adas-0001',
  'person-vehicle-bike-detection-2000',
  'person-vehicle-bike-detection-2001',
  'person-vehicle-bike-detection-2002',
  'person-vehicle-bike-detection-crossroad-0078',
  'person-vehicle-bike-detection-crossroad-1016',
  'vehicle-detection-0200',
  'vehicle-detection-0201',
  'vehicle-detection-0202',
  'vehicle-detection-adas-0002'
]

for MODEL in "${MODELS[@]}"; do
    MODEL="public/${MODEL}"
    for PREC in ${PRECISIONS//,/ }; do
        MODEL_URL="https://storage.openvinotoolkit.org/repositories/open_model_zoo/${MODEL}/1/dldt/${PREC}/${MODEL##*/}.xml"
        BIN_URL="https://storage.openvinotoolkit.org/repositories/open_model_zoo/${MODEL}/1/dldt/${PREC}/${MODEL##*/}.bin"
        DEST_DIR="${MODEL_DIR}/${MODEL}/${PREC}"
        mkdir -p "$DEST_DIR"
        echo "Downloading $MODEL ($PREC)..."
        wget -nv -O "$DEST_DIR/${MODEL##*/}.xml" "$MODEL_URL"
        wget -nv -O "$DEST_DIR/${MODEL##*/}.bin" "$BIN_URL"
    done
done

echo "All models downloaded to $MODEL_DIR"